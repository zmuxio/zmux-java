<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.zmuxio</groupId>
    <artifactId>zmux-parent</artifactId>
    <version>1.2.3</version>
    <packaging>pom</packaging>

    <name>zmux parent</name>
    <description>Parent build for the zmux Java modules.</description>
    <url>https://github.com/zmuxio/zmux-java</url>

    <organization>
        <name>zmuxio</name>
        <url>https://github.com/zmuxio</url>
    </organization>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>zmuxio</id>
            <name>zmux maintainers</name>
            <organization>zmuxio</organization>
            <organizationUrl>https://github.com/zmuxio</organizationUrl>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/zmuxio/zmux-java.git</connection>
        <developerConnection>scm:git:https://github.com/zmuxio/zmux-java.git</developerConnection>
        <url>https://github.com/zmuxio/zmux-java</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/zmuxio/zmux-java/issues</url>
    </issueManagement>

    <modules>
        <module>zmux</module>
        <module>zmux-netty-test</module>
        <module>zmux-quic</module>
        <module>zmux-shaping</module>
        <module>zmux-http</module>
        <module>zmux-bench</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <netty.version>4.2.21.Final</netty.version>
        <junit.version>6.1.3</junit.version>
        <maven.surefire.version>3.6.1</maven.surefire.version>
        <maven.deploy.version>3.2.0</maven.deploy.version>
        <maven.source.version>3.4.0</maven.source.version>
        <maven.javadoc.version>3.12.0</maven.javadoc.version>
        <surefire.forkCount>1</surefire.forkCount>
        <!-- Warnings fail the compile; a survey run may pass -Dcompiler.werror=-Xlint:-serial to list them all. -->
        <compiler.werror>-Werror</compiler.werror>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <!-- Every lint but serial, and warnings fail the build. serial: the exceptions are not meant to be
                         serialized (they carry live handles and results); declaring serialVersionUIDs would promise a
                         serialized form the library does not support. -->
                    <compilerArgs>
                        <arg>-Xlint:all,-serial</arg>
                        <arg>-Xdoclint:reference/private</arg>
                        <arg>${compiler.werror}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
                <configuration>
                    <forkCount>${surefire.forkCount}</forkCount>
                    <reuseForks>true</reuseForks>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- Error Prone on the main and test sources, not part of the default build (CI runs it):
                 mvn -Perrorprone clean test-compile. Every check runs, the experimental ones included
                 (-XepAllDisabledChecksAsWarnings), and the build's -Werror fails on any finding; the checks turned
                 off are listed below with their reasons. -->
            <id>errorprone</id>
            <properties>
                <errorprone.version>2.52.0</errorprone.version>
                <!--
                    Checks turned off for all sources.
                    Deliberate design:
                    - FutureReturnValueIgnored: the library registers completion handlers (whenComplete, thenAccept)
                      and fires closes whose outcome is observed elsewhere; the returned stage or channel future
                      carries nothing more.
                    - ArrayRecordComponent: records carry byte arrays without a copy on purpose (zero-copy payload
                      handoff); the arrays' ownership is documented where they change hands.
                    - AvoidObjectArrays: ByteBuffer[] and PipeIo[] are the gathering-write and pipe-pair shapes of
                      the carrier SPI, passed without wrapping.
                    - NonApiType: package-private scratch collections of the core are concrete ArrayLists by design;
                      no public signature has one.
                    - UnnecessaryLambda: Runnable constants and fields are single instances that are registered,
                      withdrawn or compared by identity.
                    - ReferenceEquality: every reported comparison is an intended identity test (sentinels such as
                      StreamRecv.FIN, handles, transports, loops, the exception being thrown).
                    - Interruption: blocked worker and waiting threads are woken by interrupting them, and
                      Future.cancel(true) stops a blocking dial; that is the cancellation mechanism.
                    - UnusedException: exceptions are translated to protocol and I/O types (ProtocolException,
                      InterruptedIOException, wire errors) whose cause would be a parser detail or a control signal.
                    - PreferJavaTimeOverload: the long-nanosecond overloads exist so waits need no Duration; the
                      library and the tests call them with constants on purpose.
                    - ThrowsUncheckedException: unchecked exceptions are listed in throws clauses as documentation.
                    - PublicApiNamedStreamShouldReturnStream: "stream" is the zmux stream, not java.util.stream.
                    - Java8ApiChecker: the library targets Java 25; Java 8 API availability does not apply.
                    - StringConcatToTextBlock: the reported literals are CRLF protocol text; a text block would turn
                      the line ends into LF (its suggested fix broke two HTTP requests).
                    Need annotation or Guava dependencies the library does not take:
                    - CanIgnoreReturnValueSuggester, ImmutableMemberCollection, AddNullMarkedToClass,
                      AddNullMarkedToPackageInfo, ParameterMissingNullable, ReturnMissingNullable,
                      FieldMissingNullable.
                    Code style the project does not follow (formatting and naming preferences, no defects found):
                    - MissingBraces, UnnecessarilyFullyQualified, Var, Varifier, MultiVariableDeclaration,
                      UngroupedOverloads, InconsistentOverloads, TraditionalJavadocToMarkdown, WildcardImport,
                      YodaCondition, DifferentNameButSame, BooleanParameter, NegativeBoolean, TooManyParameters,
                      ClassNamedLikeTypeParameter (X25519 is the algorithm's name).
                -->
                <ep.off>-Xep:FutureReturnValueIgnored:OFF -Xep:ArrayRecordComponent:OFF -Xep:AvoidObjectArrays:OFF -Xep:NonApiType:OFF -Xep:UnnecessaryLambda:OFF -Xep:ReferenceEquality:OFF -Xep:Interruption:OFF -Xep:UnusedException:OFF -Xep:PreferJavaTimeOverload:OFF -Xep:ThrowsUncheckedException:OFF -Xep:PublicApiNamedStreamShouldReturnStream:OFF -Xep:StringConcatToTextBlock:OFF -Xep:Java8ApiChecker:OFF -Xep:CanIgnoreReturnValueSuggester:OFF -Xep:ImmutableMemberCollection:OFF -Xep:AddNullMarkedToClass:OFF -Xep:AddNullMarkedToPackageInfo:OFF -Xep:ParameterMissingNullable:OFF -Xep:ReturnMissingNullable:OFF -Xep:FieldMissingNullable:OFF -Xep:MissingBraces:OFF -Xep:UnnecessarilyFullyQualified:OFF -Xep:Var:OFF -Xep:Varifier:OFF -Xep:MultiVariableDeclaration:OFF -Xep:UngroupedOverloads:OFF -Xep:InconsistentOverloads:OFF -Xep:TraditionalJavadocToMarkdown:OFF -Xep:WildcardImport:OFF -Xep:YodaCondition:OFF -Xep:DifferentNameButSame:OFF -Xep:BooleanParameter:OFF -Xep:NegativeBoolean:OFF -Xep:TooManyParameters:OFF -Xep:ClassNamedLikeTypeParameter:OFF</ep.off>
                <!--
                    Checks turned off for the test sources only:
                    - SystemOut: the interop peers and probes talk to their driver over stdout.
                    - InterruptedExceptionSwallowed, EmptyCatch: test threads end on any exception, and cleanup
                      ignores failures of what is being torn down.
                    - AddressSelection: tests bind and dial the loopback by name and literal on purpose.
                    - CheckedExceptionNotThrown, ThrowSpecificExceptions, CatchingUnchecked: test helpers declare and
                      catch broadly; JUnit reports whatever escapes.
                    - StringSplitter: the tests split fixed, well-formed fixture text.
                    - EnumOrdinal: tests cycle through enum constants by index to vary their inputs.
                    - NonFinalStaticField, PrivateConstructorForUtilityClass, IdentifierName, MissingJavadoc: fixture
                      state, helper holders and test names are not API.
                -->
                <ep.test.off>-Xep:SystemOut:OFF -Xep:InterruptedExceptionSwallowed:OFF -Xep:EmptyCatch:OFF -Xep:AddressSelection:OFF -Xep:CheckedExceptionNotThrown:OFF -Xep:ThrowSpecificExceptions:OFF -Xep:CatchingUnchecked:OFF -Xep:StringSplitter:OFF -Xep:EnumOrdinal:OFF -Xep:NonFinalStaticField:OFF -Xep:PrivateConstructorForUtilityClass:OFF -Xep:IdentifierName:OFF -Xep:MissingJavadoc:OFF</ep.test.off>
                <ep.args></ep.args>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <fork>true</fork>
                            <showWarnings>true</showWarnings>
                            <compilerArgs combine.children="append">
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>--should-stop=ifError=FLOW</arg>
                                <arg>-Xmaxwarns</arg>
                                <arg>100000</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                            </compilerArgs>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>com.google.errorprone</groupId>
                                    <artifactId>error_prone_core</artifactId>
                                    <version>${errorprone.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                        <executions>
                            <execution>
                                <id>default-compile</id>
                                <configuration>
                                    <compilerArgs combine.children="append">
                                        <arg>-Xplugin:ErrorProne -XepDisableWarningsInGeneratedCode -XepAllDisabledChecksAsWarnings ${ep.off} ${ep.args}</arg>
                                    </compilerArgs>
                                </configuration>
                            </execution>
                            <execution>
                                <id>default-testCompile</id>
                                <configuration>
                                    <compilerArgs combine.children="append">
                                        <arg>-Xplugin:ErrorProne -XepDisableWarningsInGeneratedCode -XepAllDisabledChecksAsWarnings ${ep.off} ${ep.test.off} ${ep.args}</arg>
                                    </compilerArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- SpotBugs on the main and test classes, not part of the default build (CI runs it):
                 mvn -Pstatic-checks test-compile spotbugs:check. The exclusions and their reasons are in spotbugs-exclude.xml. -->
            <id>static-checks</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>4.10.5.0</version>
                        <configuration>
                            <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
                            <failOnError>true</failOnError>
                            <effort>Max</effort>
                            <threshold>Low</threshold>
                            <includeTests>true</includeTests>
                            <!-- Source paths let the filter tell test sources apart. -->
                            <addSourceDirs>true</addSourceDirs>
                            <plugins>
                                <plugin>
                                    <groupId>com.h3xstream.findsecbugs</groupId>
                                    <artifactId>findsecbugs-plugin</artifactId>
                                    <version>1.14.0</version>
                                </plugin>
                                <plugin>
                                    <groupId>com.mebigfatguy.sb-contrib</groupId>
                                    <artifactId>sb-contrib</artifactId>
                                    <version>7.7.4</version>
                                </plugin>
                            </plugins>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven.source.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven.javadoc.version}</version>
                        <configuration>
                            <quiet>true</quiet>
                            <failOnError>true</failOnError>
                            <failOnWarnings>true</failOnWarnings>
                            <!-- Every doclint group but missing: the API documents each member in a summary sentence that
                                 covers its parameters and result, without one @param/@return/@throws tag per item. -->
                            <doclint>all,-missing</doclint>
                            <additionalOptions>
                                <additionalOption>-Xmaxwarns</additionalOption>
                                <additionalOption>10000</additionalOption>
                            </additionalOptions>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <version>${maven.deploy.version}</version>
                        <configuration>
                            <altDeploymentRepository>
                                local::file:${maven.multiModuleProjectDirectory}/target/staging-deploy
                            </altDeploymentRepository>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
