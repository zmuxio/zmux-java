<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <parent><groupId>io.github.zmuxio</groupId><artifactId>zmux-parent</artifactId><version>1.3.0</version></parent>
 <artifactId>zmux-shaping</artifactId><name>zmux-shaping</name>
 <description>A Shaper driven by state machines read from a definition.</description>
 <dependencies>
  <dependency><groupId>io.github.zmuxio</groupId><artifactId>zmux</artifactId><version>${project.version}</version></dependency>
  <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
 </dependencies>
 <build>
  <plugins>
   <plugin>
    <artifactId>maven-compiler-plugin</artifactId>
    <executions>
     <execution>
      <id>default-testCompile</id>
      <configuration>
       <!-- Drive the session core with an explicit clock in the bundle parity test. -->
       <compilerArgs combine.children="append">
        <arg>--add-exports=io.zmux/io.zmux.internal.core=io.zmux.shaping.machine</arg>
        <arg>--add-exports=io.zmux/io.zmux.internal.buffer=io.zmux.shaping.machine</arg>
        <arg>--add-exports=io.zmux/io.zmux.internal.wire=io.zmux.shaping.machine</arg>
       </compilerArgs>
      </configuration>
     </execution>
    </executions>
   </plugin>
   <plugin>
    <artifactId>maven-surefire-plugin</artifactId>
    <configuration>
     <argLine>--add-exports=io.zmux/io.zmux.internal.core=io.zmux.shaping.machine --add-exports=io.zmux/io.zmux.internal.buffer=io.zmux.shaping.machine --add-exports=io.zmux/io.zmux.internal.wire=io.zmux.shaping.machine</argLine>
    </configuration>
   </plugin>
  </plugins>
 </build>
</project>
