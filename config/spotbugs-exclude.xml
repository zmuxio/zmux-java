<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Public adapters keep caller-owned transport handles. -->
    <Match>
        <Class name="io.zmux.BasicDuplexConnection"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.zmux.BasicDuplexConnection$Builder"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.zmux.JoinedDuplexConnection"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.zmux.JoinedDuplexConnection$PausedOutput"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Events expose original IOExceptions. -->
    <Match>
        <Class name="io.zmux.ZmuxEvent"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Public constructors remain part of the API. -->
    <Match>
        <Class name="io.zmux.Settings"/>
        <Bug pattern="SING_SINGLETON_HAS_NONPRIVATE_CONSTRUCTOR"/>
    </Match>
</FindBugsFilter>
